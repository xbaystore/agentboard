# Copy to .env on the machine that deploys. NEVER commit a real key.
# The deployer wallet must hold a little BNB for gas on BSC mainnet.
DEPLOYER_PRIVATE_KEY=
BSC_RPC_URL=https://bsc-dataseed.binance.org
BSCSCAN_API_KEY=
# Defaults to the official mainnet Agent ID collection when unset:
# AGENT_ID_ADDRESS=0x60B9262456dE011F7d15a54CdD8c48bAaa8B022F
